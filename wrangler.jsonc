{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clipgrow",
  "compatibility_date": "2026-07-02",
  "observability": {
    "enabled": true
  },
  "main": "src/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // The Worker must see every request before a static file is served, so it
    // can gate /dashboard and /tracker behind a login server-side.
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    // Not secret -- it's visible in the OAuth redirect URL anyway.
    // The matching IG_CLIENT_SECRET is set separately via `wrangler secret put`.
    "IG_CLIENT_ID": "27584781754476534",
    // Pinned so the authorize step and the token-exchange step send a
    // byte-identical redirect_uri. Instagram compares the two and rejects the
    // exchange on any mismatch ("Error validating verification code"). Must
    // exactly equal the Redirect URI registered in the Meta app.
    "IG_REDIRECT_URI": "https://clipgrow.in/api/auth/instagram/callback"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clipgrow",
      "database_id": "5d78f12c-23f6-4abb-83f6-2574a7ea60b1"
    }
  ],
  // Chained refresh handoff. A refresh job that cannot finish inside one
  // invocation's external-subrequest budget saves its remaining work and
  // enqueues a continuation here, which wakes a fresh invocation with a fresh
  // budget. max_batch_size 1 keeps one message === one job continuation, so a
  // slow job can never starve or delay an unrelated one by being batched with
  // it. Queues are included on the Workers free plan (10k ops/day).
  "queues": {
    "producers": [
      { "queue": "clipgrow-refresh", "binding": "REFRESH_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "clipgrow-refresh",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        // Queues retries a message whose consumer invocation died outright,
        // which is the free automatic recovery that picking Queues over
        // synchronous self-chaining buys us.
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  }
}
