{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "premium-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "premium-mock",
        "run",
        "dev"
      ],
      "port": 5199,
      "autoPort": true
    },
    {
      "name": "premium-mock-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "premium-mock",
        "run",
        "preview:build"
      ],
      "port": 4180,
      "autoPort": true
    }
  ]
}
