# dependencies
node_modules/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# logs
*.log

# in-progress premium redesign mock — not part of the deployed Worker.
# Also listed in .assetsignore so `wrangler deploy` never uploads it.
premium-mock/

# staged build output of the redesign (regenerated by
# premium-mock/scripts/build-deploy.mjs). Deliberately NOT in .assetsignore:
# wrangler has to upload /new for the staging URL to exist.
new/
premium-mock/dist-new/

# local safety copies of discarded work (see .backup/README)
.backup/
